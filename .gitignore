# Source-only backup: deny by default; review additions before allowing them.
/*
!/.gitignore
!/README.md
!/SOURCE_BACKUP.md
!/app.py
!/requirements.txt
!/启动小树苗.bat
!/sapling_pet/
/sapling_pet/*
!/sapling_pet/*.py
!/tests/
/tests/*
!/tests/*.py
!/native_pet/
!/native_capybara_pet/
!/native_keyboard_pet/
/native_*/*
!/native_*/README.md
!/native_*/build.ps1
!/native_*/run.bat
!/native_*/src/
/native_*/src/*
!/native_*/src/*.cpp
!/native_*/src/*.h
!/native_keyboard_pet/app.rc
!/native_keyboard_pet/build-mouse-edition.ps1
!/native_keyboard_pet/tests/
/native_keyboard_pet/tests/*
!/native_keyboard_pet/tests/*.cpp
!/native_keyboard_pet/tools/
/native_keyboard_pet/tools/*
!/native_keyboard_pet/tools/*.py
!/native_keyboard_pet/packaging/
/native_keyboard_pet/packaging/*
!/native_keyboard_pet/packaging/*.bat
!/native_keyboard_pet/packaging/*.ps1
!/native_keyboard_pet/packaging/*.md

# Defense in depth: never include artwork, binaries, credentials, or runtime data.
**/assets/
**/build*/
**/release*/
**/__pycache__/
**/.env*
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.ico
*.svg
*.exe
*.dll
*.o
*.zip
*.7z
*.mp4
*.webm
*.pem
*.key
*.pfx
*.pyc
*.log
*.db
*.sqlite*

# Independent repository, not a submodule of the desktop pets backup.
/quick_translate/
